# att_unlock - secrets template.
# Copy to a local file (e.g. .env or a path in your secret manager) and fill
# it in. NEVER commit a filled file. The client never writes or echoes these.

# --- Authentication (your own authorized account only) ---------------------
# RECOMMENDED: raw "Cookie:" header from your browser after a normal login
# (MFA completed by you). Grab it from DevTools > Network > any request >
# Request Headers > cookie.
ATT_UNLOCK_SESSION_COOKIE=

# Alternative: path to a file containing the Cookie header.
# ATT_UNLOCK_SESSION_COOKIE_FILE=

# Alternative: login mode (interactive one-time MFA prompt; values never
# logged).
# ATT_UNLOCK_USERNAME=
# ATT_UNLOCK_PASSWORD=

# Optional local KEY=VALUE file loaded into the environment at startup.
# ATT_UNLOCK_SECRETS_FILE=

# --- Behavior ---------------------------------------------------------------
ATT_UNLOCK_BASE_URL=https://www.att.com
ATT_UNLOCK_TIMEOUT=20
ATT_UNLOCK_MIN_SUBMIT_INTERVAL=300
# ATT_UNLOCK_USER_AGENT=
# ATT_UNLOCK_VERIFY_TLS=1
