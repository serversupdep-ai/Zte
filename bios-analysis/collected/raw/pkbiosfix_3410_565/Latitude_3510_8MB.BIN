<style>
/* PKBIOSFIX Cobalt upgrade notice: isolated from plans, checkout and other cards. */
.pkb-upgradeCard {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    align-items: center;
    gap: 36px;
    padding: 40px;
    margin: 0 0 24px;
    overflow: hidden;
    border: 1px solid var(--pkbg-line, #dce2e9);
    border-radius: 20px;
    background: var(--pkbg-panel, #fff);
    color: var(--pkbg-ink, #132437);
    box-shadow: 0 12px 32px rgba(9, 28, 48, .05);
    font-family: 'DM Sans', sans-serif;
}
.pkb-upgradeCard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, #236be4, #69b8f6 65%, transparent);
}
.pkb-upgradeCard__content { min-width: 0; }
.pkb-upgradeCard svg { fill: none; }
.pkb-upgradeCard__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--pkbg-soft, #e9eef5);
    color: var(--pkbg-link, #236be4);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
}
.pkb-upgradeCard__eyebrow svg { width: 14px; height: 14px; }
.pkb-upgradeCard .pkb-upgradeCard__title {
    margin: 18px 0 12px;
    color: var(--pkbg-ink, #132437);
    font: 500 32px/1.18 'Space Grotesk', sans-serif;
    letter-spacing: -.8px;
}
.pkb-upgradeCard__description {
    max-width: 560px;
    margin: 0;
    color: var(--pkbg-muted, #596778);
    font-size: 15px;
    line-height: 1.7;
}
.pkb-upgradeCard__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
.pkb-upgradeCard a.pkb-upgradeCard__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 18px;
    border: 1px solid #236be4;
    border-radius: 9px;
    background: #236be4;
    color: #fff;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 700;
    text-decoration: none;
    transition: background-color .15s ease, border-color .15s ease;
}
.pkb-upgradeCard a.pkb-upgradeCard__button:hover { background: #1959c4; border-color: #1959c4; }
.pkb-upgradeCard a.pkb-upgradeCard__button:focus-visible { outline: 3px solid var(--pkbg-link, #236be4); outline-offset: 4px; }
.pkb-upgradeCard a.pkb-upgradeCard__button--contact {
    background: var(--pkbg-panel, #fff);
    color: var(--pkbg-ink, #132437);
    border-color: var(--pkbg-line, #dce2e9);
}
.pkb-upgradeCard a.pkb-upgradeCard__button--contact:hover { background: var(--pkbg-soft, #e9eef5); border-color: var(--pkbg-link, #236be4); }
.pkb-upgradeCard__button svg { flex: none; width: 18px; height: 18px; }
.pkb-upgradeCard__button--contact svg { color: light-dark(#168447, #65d992); }
.pkb-upgradeCard__note { margin: 14px 0 0; color: var(--pkbg-muted, #596778); font-size: 12px; line-height: 1.6; }
.pkb-upgradeCard__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    padding: 18px;
    border: 1px solid var(--pkbg-line, #dce2e9);
    border-radius: 15px;
    background: radial-gradient(ellipse at 50% 35%, rgba(35,107,228,.13), transparent 70%), var(--pkbg-soft, #e9eef5);
    color: var(--pkbg-link, #236be4);
}
.pkb-upgradeCard__chip { display: block; width: 176px; max-width: 100%; height: 148px; }
.pkb-upgradeCard__visualName { margin-top: 10px; color: var(--pkbg-ink, #132437); font: 500 16px/1.4 'Space Grotesk', sans-serif; letter-spacing: .8px; }
.pkb-upgradeCard__visualCaption { margin-top: 5px; color: var(--pkbg-muted, #596778); font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; }
@media (max-width: 900px) {
    .pkb-upgradeCard { grid-template-columns: minmax(0, 1fr) 180px; gap: 24px; padding: 30px; }
    .pkb-upgradeCard__visual { min-height: 210px; padding: 12px; }
    .pkb-upgradeCard .pkb-upgradeCard__title { font-size: 28px; }
}
@media (max-width: 650px) {
    .pkb-upgradeCard { display: block; padding: 26px 22px; border-radius: 16px; }
    .pkb-upgradeCard__visual { display: none; }
    .pkb-upgradeCard .pkb-upgradeCard__title { font-size: 25px; letter-spacing: -.5px; }
    .pkb-upgradeCard__description { font-size: 14px; }
    .pkb-upgradeCard__actions { flex-direction: column; margin-top: 22px; gap: 10px; }
    .pkb-upgradeCard a.pkb-upgradeCard__button { width: 100%; min-height: 48px; padding-inline: 10px; }
}
@media (prefers-reduced-motion: reduce) {
    .pkb-upgradeCard a.pkb-upgradeCard__button { transition: none; }
}
</style>

