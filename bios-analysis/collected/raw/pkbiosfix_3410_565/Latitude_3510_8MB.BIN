<script>
(function() {
    var SEL = ".p-navInlineSearch, .pkbLand-search";
    function setClosed(form, closed) {
        form.querySelectorAll(".autoCompleteList").forEach(function(l) {
            l.classList.toggle("pkb-acClosed", closed);
        });
    }
    document.addEventListener("click", function(e) {
        document.querySelectorAll(SEL).forEach(function(f) {
            if (!f.contains(e.target)) { setClosed(f, false); setClosed(f, true); }
            else if (e.target.tagName === "INPUT") { setClosed(f, false); }
        });
    });
    document.addEventListener("focusin", function(e) {
        if (e.target.tagName !== "INPUT") return;
        document.querySelectorAll(SEL).forEach(function(f) {
            if (f.contains(e.target)) { setClosed(f, false); }
        });
    });
    document.addEventListener("input", function(e) {
        if (e.target.tagName !== "INPUT") return;
        var f = e.target.closest(SEL);
        if (f) { setClosed(f, false); }
    });
})();
</script>
              
