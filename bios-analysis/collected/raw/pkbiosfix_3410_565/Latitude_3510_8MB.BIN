	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', 'G-HP95QL7HNX', {
			// 
			
			
		});

		/* gtag.js is ~181KB - about half this site's page weight - and on slow
		   connections it monopolised the pipe for 8-11s, which kept the browser's
		   loading spinner running long after the page was visually complete.
		   Injecting it only after `load` has fired means it can never hold the
		   load event open. Calls made before it arrives are queued in dataLayer
		   and replayed when it loads, so no hits are lost. */
		(function () {
			var injected = false;
			function loadGtag() {
				if (injected) { return; }
				injected = true;
				var s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HP95QL7HNX';
				document.head.appendChild(s);
			}
			if (document.readyState === 'complete') {
				loadGtag();
			} else {
				window.addEventListener('load', loadGtag);
			}
		})();
	</script>

	
	
	
