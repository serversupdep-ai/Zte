        <section id="m27" data-module="TemplateSectionBreak" data-g-section-id="section-break">
          <div style="Grid_grid" class="Grid_grid TemplateSectionBreak_grid">
            <div style="--gws-column-laptop-start:3;--gws-column-laptop-end:10;" class="Grid_column TemplateSectionBreak_container">
              <div class="Text_container Text_body Text_lg TemplateSectionBreak_copyGroup">
                <h2 class="Heading_heading heading Heading_size:h4">Block ransomware proliferation with Drive for desktop</h2>
                <p>With AI-powered virus detection seamlessly integrated into Drive for desktop, customers have real-time ransomware detection, instant file recovery, and enhanced data security. Protect your business from costly downtime and data loss.</p>
              </div>
            </div>
          </div>
        </section>
