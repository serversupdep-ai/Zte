        <div id="m20" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:92px;--gws-spacer-desktop-size:120px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all"></div>
        </div>
        <section id="security" data-module="TemplateSectionBreak" data-g-section-id="security">
          <div style="Grid_grid" class="Grid_grid TemplateSectionBreak_grid">
            <div style="--gws-column-laptop-start:3;--gws-column-laptop-end:10;" class="Grid_column TemplateSectionBreak_container">
              <div class="Text_container Text_body Text_lg TemplateSectionBreak_copyGroup">
                <h2 class="Heading_heading heading Heading_size:h3">Secure cloud storage you can count on</h2>
                <p>Keep your data in trusted, compliant, and reliable cloud infrastructure that seamlessly integrates with your Workspace apps.</p>
              </div>
            </div>
          </div>
        </section>
        <div id="m22" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:36px;--gws-spacer-tablet-size:36px;--gws-spacer-desktop-size:36px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all"></div>
        </div>
        <section id="m23" data-module="TemplateMulticolumnCarousel" data-g-section-id="multicolumn-carousel">
          <div class="TemplateMulticolumnCarousel_wrap">
            <div style="--card-count:3;" data-count="3" class="TemplateMulticolumnCarousel_cards TemplateMulticolumnCarousel_laptopOnly">
              <div class="TemplateMulticolumnCarousel_card align:center">
                <picture><img src="https://lh3.googleusercontent.com/ZxuPdjkK9OHpQbE7STH0XP4mcWt7PJk93zduGDjy7HOFXOKuHL6VO6tXKqlU4PFsn25fv92i_OSyDL34OV7Xq6wxp-T09gnKTizP6Q=e365-pa-nu-rw-w739" srcset="https://lh3.googleusercontent.com/ZxuPdjkK9OHpQbE7STH0XP4mcWt7PJk93zduGDjy7HOFXOKuHL6VO6tXKqlU4PFsn25fv92i_OSyDL34OV7Xq6wxp-T09gnKTizP6Q=e365-pa-nu-rw-w739 1x, https://lh3.googleusercontent.com/ZxuPdjkK9OHpQbE7STH0XP4mcWt7PJk93zduGDjy7HOFXOKuHL6VO6tXKqlU4PFsn25fv92i_OSyDL34OV7Xq6wxp-T09gnKTizP6Q=e365-pa-nu-rw-w739 2x" alt="A file saved on Google Drive
" width="739" height="415" loading="lazy" class="TemplateMulticolumnCarousel_cardImage" /></picture>
                <div class="TemplateMulticolumnCarousel_contentContainer">
                  <div class="TemplateMulticolumnCarousel_badgeContainer"></div>
                  <h3 class="Heading_heading heading Heading_size:h5 TemplateMulticolumnCarousel_cardTitle">Cloud-native, enterprise-ready</h3>
                  <div class="Text_container Text_body Text_lg TemplateMulticolumnCarousel_cardBody">
