                  c.removeAttribute("has-active-condition");
                  f && f.setAttribute("active", "")
                }
              })();
            </script>
          </gws-dynamic-module-container></section>
        <div id="m4" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:60px;--gws-spacer-desktop-size:60px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet"></div>
        </div>
        <section id="migration" data-module="TemplateTwoColumn" data-g-section-id="migration">
          <div class="TemplateTwoColumn_template">
            <div style="Grid_grid" class="Grid_grid TemplateTwoColumn_grid">
              <div style="--gws-column-tablet-start:1;--gws-column-tablet-end:12;--gws-column-laptop-start:2;--gws-column-laptop-end:5;" class="Grid_column TemplateTwoColumn_content">
                <div>
                  <div class="TemplateTwoColumn_headingRow">
                    <h2 class="Heading_heading heading Heading_size:h4 TemplateTwoColumn_heading">Say goodbye to file silos and content chaos</h2>
                  </div>
                  <div class="Text_container Text_body Text_lg TemplateTwoColumn_body">
                    <p>Move your data and store all of your files in one place with Google Drive. AI-powered storage in the cloud helps teams collaborate in real-time, making it faster to find files and insights, backed by Google’s industry-leading data security for added protection.</p><span class="gws-button"><a href="/solutions/migration/drive-migration/ " data-g-event="drive: body #migration" data-g-action="/solutions/migration/drive-migration/" data-g-label="/solutions/migration/drive-migration/ " data-uj-def="body_migration" aria-label="Learn more (Start a trial): Migrate to Google Drive" class="button button--inline button--full-width"><span class="button__content">Learn more</span></a></span>
                  </div>
                </div>
              </div>
              <div style="--gws-column-tablet-start:1;--gws-column-tablet-end:12;--gws-column-laptop-start:6;--gws-column-laptop-end:11;" class="Grid_column TemplateTwoColumn_featureImage">
                <picture>
                  <source srcset="https://lh3.googleusercontent.com/zsBk18zZAiO7ehdkCq7RXKq2_BOABMNqx_8TSbBtEx8srP-6Pc8QnpWEXNykE4pEUaNEpxkpM678KtvZV625982rNHVpTNvU1tA=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/zsBk18zZAiO7ehdkCq7RXKq2_BOABMNqx_8TSbBtEx8srP-6Pc8QnpWEXNykE4pEUaNEpxkpM678KtvZV625982rNHVpTNvU1tA=e365-pa-nu-s0-rw 2x" media="(min-width: 1024px)" width="1132" height="828" type="image/webp" />
                  <source srcset="https://lh3.googleusercontent.com/A0sEQT5lVfvC7U_XlN_UK65jZ_v1KbmaOwjJmrYIsO5r7FwtitkXWyl8d6iDNCKKad8FOsXNCeF1J9lTFEj4TwRTmwYNvJtrHSw=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/A0sEQT5lVfvC7U_XlN_UK65jZ_v1KbmaOwjJmrYIsO5r7FwtitkXWyl8d6iDNCKKad8FOsXNCeF1J9lTFEj4TwRTmwYNvJtrHSw=e365-pa-nu-s0-rw 2x" media="(min-width: 600px)" width="1188" height="668" type="image/webp" /><img src="https://lh3.googleusercontent.com/pQp2r0ejbZeNKFpJ2vLAlol3Xx0m8Yc5ifSzsm0VWYVh1Ccmxkx0oj6Q0gWOKvtRQ7S1cT_2slAvRNWZ3uxMvbLHt8CdvWxAzo4E=e365-pa-nu-s0-rw" srcset="https://lh3.googleusercontent.com/pQp2r0ejbZeNKFpJ2vLAlol3Xx0m8Yc5ifSzsm0VWYVh1Ccmxkx0oj6Q0gWOKvtRQ7S1cT_2slAvRNWZ3uxMvbLHt8CdvWxAzo4E=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/pQp2r0ejbZeNKFpJ2vLAlol3Xx0m8Yc5ifSzsm0VWYVh1Ccmxkx0oj6Q0gWOKvtRQ7S1cT_2slAvRNWZ3uxMvbLHt8CdvWxAzo4E=e365-pa-nu-s0-rw 2x" alt="A user starts typing a file name into the Google Drive search tool, and a list of potential matches appears." width="1132" height="828" loading="eager" fetchpriority="high" />
                </picture>
              </div>
            </div>
          </div>
        </section>
        <div id="m6" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:92px;--gws-spacer-desktop-size:120px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all"></div>
        </div>
        <section id="gemini-in-drive" data-module="TemplateTwoColumn" data-g-section-id="gemini-in-drive">
          <div class="TemplateTwoColumn_template">
            <div style="Grid_grid" class="Grid_grid TemplateTwoColumn_grid">
              <div style="--gws-column-tablet-start:2;--gws-column-tablet-end:11;--gws-column-laptop-start:2;--gws-column-laptop-end:7;" class="Grid_column TemplateTwoColumn_featureImage TemplateTwoColumn_sixtyForty TemplateTwoColumn_isVideo"><gws-youtube-video video-id="ehpQkxedxP0" play-button="red" aspect-ratio="1280/720" rounded style="--gws-youtube-video-aspect-ratio:1280/720;">
                  <picture slot="poster"><img src="https://img.youtube.com/vi/ehpQkxedxP0/maxresdefault.jpg" srcset="https://img.youtube.com/vi/ehpQkxedxP0/maxresdefault.jpg 1x, https://img.youtube.com/vi/ehpQkxedxP0/maxresdefault.jpg 2x" alt="YouTube video poster" width="1280" height="720" loading="eager" fetchpriority="high" class="YouTubeVideo_poster" /></picture>
                </gws-youtube-video></div>
              <div style="--gws-column-tablet-start:2;--gws-column-tablet-end:11;--gws-column-laptop-start:8;--gws-column-laptop-end:11;" class="Grid_column TemplateTwoColumn_content TemplateTwoColumn_fixedLeftPadding TemplateTwoColumn_sixtyForty TemplateTwoColumn_isVideo">
                <div>
                  <div class="TemplateTwoColumn_headingRow">
                    <h2 class="Heading_heading heading Heading_size:h4 TemplateTwoColumn_heading">Turn files into knowledge with Gemini in Google Drive</h2>
                  </div>
                  <div class="Text_container Text_body Text_lg TemplateTwoColumn_body">
                    <p>AI Overviews in Drive delivers instant, cited answers so you can stop digging and start finding. Ask Gemini in Drive provides grounded, detailed responses based on your content across Drive, Gmail, Calendar, and Chat—all within your control via customizable, shareable Drive projects.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <div id="m8" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:92px;--gws-spacer-desktop-size:120px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all"></div>
        </div>
        <section id="store" data-module="TemplateSectionBreak" data-g-section-id="store">
          <div style="Grid_grid" class="Grid_grid TemplateSectionBreak_grid">
            <div style="--gws-column-laptop-start:4;--gws-column-laptop-end:9;" class="Grid_column TemplateSectionBreak_container">
              <div class="Text_container Text_body Text_lg TemplateSectionBreak_copyGroup">
                <h2 class="Heading_heading heading Heading_size:h3">Cloud storage made easy </h2>
                <p>Simple and scalable cloud storage for people and teams of all sizes. Upload, open, share and edit files from any device.</p>
              </div>
            </div>
          </div>
        </section>
        <div id="m10" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:36px;--gws-spacer-tablet-size:36px;--gws-spacer-desktop-size:36px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all"></div>
        </div>
        <section id="m11" data-module="Template5050Accordion" data-g-section-id="5050-accordion"><gws-accordion-5050-container slide-timing="15" current="0">
            <div style="Grid_grid" class="Grid_grid Template5050Accordion_container">
              <div style="--gws-column-tablet-start:3;--gws-column-tablet-end:10;--gws-column-laptop-start:2;--gws-column-laptop-end:5;" class="Grid_column">
                <div class="Template5050Accordion_column">
                  <div class="Template5050Accordion_inner"><gws-accordion-item index="0" current="true" data-g-event="products/drive: body" data-g-label="/products/drive/" data-g-action="click: Storage that grows with you">
                      <div slot="heading">
                        <h3 style="--text-font-weight:500;" class="Text_container Text_subheading Text_weight AccordionItem_heading">Storage that grows with you</h3>
                      </div>
                      <div slot="body">
                        <div class="Text_container Text_body Text_lg AccordionItem_body">
                          <p>Scale your storage effortlessly from 15GB to 5TB per user, plus the ability to request additional storage. Storage costs vary.</p>
                        </div>
                      </div>
                      <div slot="image" class="AccordionItem_imageContainer AccordionItem_ytContainer">
                        <picture>
                          <source srcset="https://lh3.googleusercontent.com/coJlLEQCjPyZdnsMa856YynwlBWiUwAWZtQkoyD4x5KCmkY_69uSH_7M51QEdNRJKgJ8lbmaaore3IC7SpsfzRYo6Mq6UhjSfFrL=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/coJlLEQCjPyZdnsMa856YynwlBWiUwAWZtQkoyD4x5KCmkY_69uSH_7M51QEdNRJKgJ8lbmaaore3IC7SpsfzRYo6Mq6UhjSfFrL=e365-pa-nu-s0-rw 2x" media="(min-width: 1024px)" width="1188" height="668" type="image/webp" />
                          <source srcset="https://lh3.googleusercontent.com/C6Wthe5lPRvkRy3moKIY4W6jf-0850CqFygJ5CkVuwduTO5pVpV3q9yDqskUfpVM9caThzhN8a8sDiplIXBZ4M9baqqli5wMzbFw=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/C6Wthe5lPRvkRy3moKIY4W6jf-0850CqFygJ5CkVuwduTO5pVpV3q9yDqskUfpVM9caThzhN8a8sDiplIXBZ4M9baqqli5wMzbFw=e365-pa-nu-s0-rw 2x" media="(min-width: 600px)" width="944" height="600" type="image/webp" /><img src="https://lh3.googleusercontent.com/92_7-TAelqP-ZO9NOMlwm34uzT4zB_-JbKJY7INuETNkHiQXjuG5hPo7nT7XardCEbGRPR6K8cuRx06A_T4JuhJqAT9lfHtQx050=e365-pa-nu-s0-rw" srcset="https://lh3.googleusercontent.com/92_7-TAelqP-ZO9NOMlwm34uzT4zB_-JbKJY7INuETNkHiQXjuG5hPo7nT7XardCEbGRPR6K8cuRx06A_T4JuhJqAT9lfHtQx050=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/92_7-TAelqP-ZO9NOMlwm34uzT4zB_-JbKJY7INuETNkHiQXjuG5hPo7nT7XardCEbGRPR6K8cuRx06A_T4JuhJqAT9lfHtQx050=e365-pa-nu-s0-rw 2x" alt="Indicating 30 gigabytes of storage used in Google Workspace" width="608" height="500" loading="lazy" />
                        </picture>
                      </div>
                    </gws-accordion-item><gws-accordion-item index="1" current="false" data-g-event="products/drive: body" data-g-label="/products/drive/" data-g-action="click: Gmail attachments straight to Drive">
                      <div slot="heading">
                        <h3 style="--text-font-weight:500;" class="Text_container Text_subheading Text_weight AccordionItem_heading">Gmail attachments straight to Drive </h3>
                      </div>
                      <div slot="body">
                        <div class="Text_container Text_body Text_lg AccordionItem_body">
                          <p>Save and organize <span class="gws-button"><a href="https://workspace.google.com/products/gmail/" data-g-event="drive: body #5050-accordion" data-g-action="https://workspace.google.com/products/gmail/" data-g-label="https://workspace.google.com/products/gmail/" data-uj-def="body_5050_accordion" aria-label="Open the Gmail page" class="button button--inline"><span class="button__content">Gmail</span></a></span> attachments directly to Drive without leaving your inbox.</p>
                        </div>
                      </div>
                      <div slot="image" class="AccordionItem_imageContainer AccordionItem_ytContainer">
                        <picture>
                          <source srcset="https://lh3.googleusercontent.com/NSHGsFbjf551d05RmWNGLXTHmWiOHPqDN1Itt2x0m6_PKvopncVYgAWGYzkBBtYp0gxXdYmq6xZmjnhD4DNxZciS2lWSoy8qM-4=e365-pa-nu-rw-w684 1x, https://lh3.googleusercontent.com/NSHGsFbjf551d05RmWNGLXTHmWiOHPqDN1Itt2x0m6_PKvopncVYgAWGYzkBBtYp0gxXdYmq6xZmjnhD4DNxZciS2lWSoy8qM-4=e365-pa-nu-rw-w1368 2x" media="(min-width: 1024px)" width="1368" height="1000" type="image/webp" />
                          <source srcset="https://lh3.googleusercontent.com/viCOw8l8mEa6UBka21wr9hFq22em4-OWPqkiJlbsFkDREPn_pLpAIfFo0EDp2EHU0Uep96E8m87kI1SD8M4gy-Rqlba5oOev6bv6Nw=e365-pa-nu-rw-w632 1x, https://lh3.googleusercontent.com/viCOw8l8mEa6UBka21wr9hFq22em4-OWPqkiJlbsFkDREPn_pLpAIfFo0EDp2EHU0Uep96E8m87kI1SD8M4gy-Rqlba5oOev6bv6Nw=e365-pa-nu-rw-w944 2x" media="(min-width: 600px)" width="944" height="600" type="image/webp" /><img src="https://lh3.googleusercontent.com/uCOoo1Ozd61vngDht20oTu7ycVrihH_FnO42Mp3qZe2_x5PWmMACgxLLoceK8BwFDXOPFMvrK1Th7T9XaGETIu-gXRTEvygMHGVhMA=e365-pa-nu-rw-w527" srcset="https://lh3.googleusercontent.com/uCOoo1Ozd61vngDht20oTu7ycVrihH_FnO42Mp3qZe2_x5PWmMACgxLLoceK8BwFDXOPFMvrK1Th7T9XaGETIu-gXRTEvygMHGVhMA=e365-pa-nu-rw-w527 1x, https://lh3.googleusercontent.com/uCOoo1Ozd61vngDht20oTu7ycVrihH_FnO42Mp3qZe2_x5PWmMACgxLLoceK8BwFDXOPFMvrK1Th7T9XaGETIu-gXRTEvygMHGVhMA=e365-pa-nu-rw-w608 2x" alt="Attaching a pdf invoice from Drive directly to an email in Gmail" width="608" height="500" loading="lazy" />
                        </picture>
                      </div>
                    </gws-accordion-item><gws-accordion-item index="2" current="false" data-g-event="products/drive: body" data-g-label="/products/drive/" data-g-action="click: Scan documents with Drive">
                      <div slot="heading">
                        <h3 style="--text-font-weight:500;" class="Text_container Text_subheading Text_weight AccordionItem_heading">Scan documents with Drive</h3>
                      </div>
                      <div slot="body">
                        <div class="Text_container Text_body Text_lg AccordionItem_body">
                          <p>Quickly scan and store receipts, billing statements and more as searchable PDFs, directly from the Drive app for Android or iOS.</p>
                        </div>
                      </div>
                      <div slot="image" class="AccordionItem_imageContainer AccordionItem_ytContainer">
                        <picture>
                          <source srcset="https://lh3.googleusercontent.com/ILEqAlQtyZsNUyrDKe61Okib9IJseWKsgfTpRVMa5YRtkltXxJ2Fj9DWp-1a644wRroitz2XiurkHnY_Mpq2dwYfpAGbTqb7BooplQ=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/ILEqAlQtyZsNUyrDKe61Okib9IJseWKsgfTpRVMa5YRtkltXxJ2Fj9DWp-1a644wRroitz2XiurkHnY_Mpq2dwYfpAGbTqb7BooplQ=e365-pa-nu-s0-rw 2x" media="(min-width: 1024px)" width="1368" height="1000" type="image/webp" />
                          <source srcset="https://lh3.googleusercontent.com/QtQ7YGVgU36t6PKa10hcXM8spNRQ3P5-7xrxOifJ55164kg1N8HTHHe479mkW5PIOQz12YoKdyJPDHOIUYdP4DHgpkXl9bEMR8TEbQ=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/QtQ7YGVgU36t6PKa10hcXM8spNRQ3P5-7xrxOifJ55164kg1N8HTHHe479mkW5PIOQz12YoKdyJPDHOIUYdP4DHgpkXl9bEMR8TEbQ=e365-pa-nu-s0-rw 2x" media="(min-width: 600px)" width="944" height="600" type="image/webp" /><img src="https://lh3.googleusercontent.com/le1aR04eAZvI6V7NKaLbokezsolzHyVnn35GgiQdig0Vhd23w2D8o6dqyTkPTaeFfjwX3fWfQrNZ3JxRNI6saxRX_tPXPAVz65JmzQ=e365-pa-nu-s0-rw" srcset="https://lh3.googleusercontent.com/le1aR04eAZvI6V7NKaLbokezsolzHyVnn35GgiQdig0Vhd23w2D8o6dqyTkPTaeFfjwX3fWfQrNZ3JxRNI6saxRX_tPXPAVz65JmzQ=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/le1aR04eAZvI6V7NKaLbokezsolzHyVnn35GgiQdig0Vhd23w2D8o6dqyTkPTaeFfjwX3fWfQrNZ3JxRNI6saxRX_tPXPAVz65JmzQ=e365-pa-nu-s0-rw 2x" alt="Scanning a pdf grocery bill with a phone into Drive" width="608" height="500" loading="lazy" />
