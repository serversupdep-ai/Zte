            <script nonce="XIg_wx6pWplMHfRRJr57aA">
              (function() {
                var c = document.currentScript.parentNode,
                  cs = c.querySelectorAll('[slot="condition"]'),
                  f = c.querySelector('[slot="fallback"]'),
                  ps = new URLSearchParams(window.location.search),
                  r = document.referrer || "",
                  m = false;

                function ck(el) {
                  var ts = (el.getAttribute("data-condition-type") || "").split(",").filter(Boolean),
                    vs = (el.getAttribute("data-match-value") || "").split(",");
                  if (!ts.length || ts.length !== vs.length) return false;
                  var map = {
                    "HTTP referrer": "ref",
                    "source in URL": "source",
                    "uj params in URL": "uj",
                    "uj params in sessionStorage": "session",
                    "utm_campaign in URL": "utm_campaign",
                    "utm_source in URL": "utm_source",
                    "utm_term in URL": "utm_term",
                    "any param in URL": "query",
                    "WISP signal": "wisp"
                  };
                  for (var i = 0; i < ts.length; i++) {
                    var cfg = map[ts[i]];
                    if (!cfg) return false;
                    var v = null;
                    if (cfg === "wisp") {
                      if (!document.documentElement.hasAttribute("data-wisp-active")) return false;
                      var ld = window.WISP_SIGNAL_DATA;
                      if (!ld) return false;
                      var ogs = vs[i].split("|"),
                        om = false;
                      for (var j = 0; j < ogs.length; j++) {
                        var acs = ogs[j].split(","),
                          am = true;
                        for (var k = 0; k < acs.length; k++) {
                          var pts = acs[k].trim().split("."),
                            cur = ld;
                          for (var p = 0; p < pts.length; p++) {
                            if (cur && typeof cur === "object") cur = cur[pts[p]];
                            else {
                              cur = null;
                              break
                            }
                          }
                          if (!cur) {
                            am = false;
                            break
                          }
                        }
                        if (am) {
                          om = true;
                          break
                        }
                      }
                      if (!om) return false;
                      continue
                    }
                    if (cfg === "query") v = window.location.search.substring(1);
                    else if (cfg === "session") {
                      try {
                        v = window.sessionStorage.getItem("uj")
                      } catch (e) {}
                    } else if (cfg === "ref") v = r;
                    else v = ps.get(cfg);
                    if (v === null) return false;
                    var ogs = vs[i].split("|"),
                      om = false;
                    for (var j = 0; j < ogs.length; j++) {
                      var acs = ogs[j].split(","),
                        am = true;
                      for (var k = 0; k < acs.length; k++) {
                        if (v.indexOf(acs[k].trim()) === -1) {
                          am = false;
                          break
                        }
                      }
                      if (am) {
                        om = true;
                        break
                      }
                    }
                    if (!om) return false
                  }
                  return true
                }
                for (var i = 0; i < cs.length; i++) {
                  if (!m && ck(cs[i])) {
                    cs[i].setAttribute("active", "");
                    m = true
                  } else {
                    cs[i].removeAttribute("active")
                  }
                }
                if (m) {
                  c.setAttribute("has-active-condition", "");
                  f && f.removeAttribute("active")
                } else {
                  c.removeAttribute("has-active-condition");
                  f && f.setAttribute("active", "")
                }
              })();
            </script>
          </gws-dynamic-module-container></section>
