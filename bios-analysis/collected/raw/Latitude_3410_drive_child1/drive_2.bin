                    <picture><img src="https://lh3.googleusercontent.com/ol2xXubqG8OEcW1u_4hx2WtjjV4QGpbhYys5pbHo2iL0r4T9YEUP71bqTG8LLpIaMtRg1aGLhAL3vGybQYSv1xC-LRl-1nxPGR15=e365-pa-nu-rw-w684" srcset="https://lh3.googleusercontent.com/ol2xXubqG8OEcW1u_4hx2WtjjV4QGpbhYys5pbHo2iL0r4T9YEUP71bqTG8LLpIaMtRg1aGLhAL3vGybQYSv1xC-LRl-1nxPGR15=e365-pa-nu-rw-w684 1x, https://lh3.googleusercontent.com/ol2xXubqG8OEcW1u_4hx2WtjjV4QGpbhYys5pbHo2iL0r4T9YEUP71bqTG8LLpIaMtRg1aGLhAL3vGybQYSv1xC-LRl-1nxPGR15=e365-pa-nu-rw-w1368 2x" alt="Highlighting text to add a comment to a pdf" width="1368" height="1000" aria-hidden="true" loading="lazy" class="Template5050Accordion_laptopImage" /></picture>
                  </div>
                  <div data-image-index="2" data-image-state="hidden">
                    <picture><img src="https://lh3.googleusercontent.com/dFHS6XWZ_kIH8Xk1suewW316HRAhXn9XL4v_5gscX8D479l1gVjx7dZVB9wKIf_wfr3f52Cl5v63A17g0CnCkKRIAZ22Av8MtQEnAw=e365-pa-nu-s0-rw" srcset="https://lh3.googleusercontent.com/dFHS6XWZ_kIH8Xk1suewW316HRAhXn9XL4v_5gscX8D479l1gVjx7dZVB9wKIf_wfr3f52Cl5v63A17g0CnCkKRIAZ22Av8MtQEnAw=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/dFHS6XWZ_kIH8Xk1suewW316HRAhXn9XL4v_5gscX8D479l1gVjx7dZVB9wKIf_wfr3f52Cl5v63A17g0CnCkKRIAZ22Av8MtQEnAw=e365-pa-nu-s0-rw 2x" alt="Searching Drive and receiving file and folder results
" width="1368" height="1000" aria-hidden="true" loading="lazy" class="Template5050Accordion_laptopImage" /></picture>
                  </div>
                  <div data-image-index="3" data-image-state="hidden">
                    <picture><img src="https://lh3.googleusercontent.com/2HqYqW5oTUWFEyiynJ2DAam7LFqadPKQ1xIem9q4eSsAX0gPGP2ON99vV4OizBuhYs8A91mF8zmI1Mm_xRRildEvm_VxhPgUdPco=e365-pa-nu-s0-rw" srcset="https://lh3.googleusercontent.com/2HqYqW5oTUWFEyiynJ2DAam7LFqadPKQ1xIem9q4eSsAX0gPGP2ON99vV4OizBuhYs8A91mF8zmI1Mm_xRRildEvm_VxhPgUdPco=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/2HqYqW5oTUWFEyiynJ2DAam7LFqadPKQ1xIem9q4eSsAX0gPGP2ON99vV4OizBuhYs8A91mF8zmI1Mm_xRRildEvm_VxhPgUdPco=e365-pa-nu-s0-rw 2x" alt="Recent activity list in Drive, including access requests and comments
