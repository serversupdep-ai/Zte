        <section id="m15" data-module="Template5050Accordion" data-g-section-id="5050-accordion"><gws-accordion-5050-container slide-timing="15" current="0">
            <div style="Grid_grid" class="Grid_grid Template5050Accordion_container">
              <div style="--gws-column-tablet-start:3;--gws-column-tablet-end:10;--gws-column-laptop-start:2;--gws-column-laptop-end:7;" class="Grid_column Template5050Accordion_featuredImage">
                <div class="Template5050Accordion_column">
                  <div data-image-index="0" data-image-state="visible">
                    <picture><img src="https://lh3.googleusercontent.com/3sLch4ekxWH37o_wVVS45wGAYXsTpTDGTj2IpdDHBOuusueuQUrZQz7kuCrchXcWFvCiG4xb6mwaS9bHcWbBvAYTsTn6EPWSN0_L=e365-pa-nu-s0-rw" srcset="https://lh3.googleusercontent.com/3sLch4ekxWH37o_wVVS45wGAYXsTpTDGTj2IpdDHBOuusueuQUrZQz7kuCrchXcWFvCiG4xb6mwaS9bHcWbBvAYTsTn6EPWSN0_L=e365-pa-nu-s0-rw 1x, https://lh3.googleusercontent.com/3sLch4ekxWH37o_wVVS45wGAYXsTpTDGTj2IpdDHBOuusueuQUrZQz7kuCrchXcWFvCiG4xb6mwaS9bHcWbBvAYTsTn6EPWSN0_L=e365-pa-nu-s0-rw 2x" alt="A logo cloud of popular Google Workspace products" width="1368" height="1000" aria-hidden="false" loading="lazy" class="Template5050Accordion_laptopImage" /></picture>
