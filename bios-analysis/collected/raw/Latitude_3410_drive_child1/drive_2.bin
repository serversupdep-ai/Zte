        <script nonce="XIg_wx6pWplMHfRRJr57aA">
          (function() {
            var c = document.currentScript.parentNode,
              cs = c.querySelectorAll('[slot="condition"]'),
              f = c.querySelector('[slot="fallback"]'),
              ps = new URLSearchParams(window.location.search),
              r = document.referrer || "",
              m = false;

            function ck(el) {
              var ts = (el.getAttribute("data-condition-type") || "").split(",").filter(Boolean),
                vs = (el.getAttribute("data-match-value") || "").split(",");
              if (!ts.length || ts.length !== vs.length) return false;
              var map = {
                "HTTP referrer": "ref",
                "source in URL": "source",
                "uj params in URL": "uj",
                "uj params in sessionStorage": "session",
                "utm_campaign in URL": "utm_campaign",
                "utm_source in URL": "utm_source",
                "utm_term in URL": "utm_term",
                "any param in URL": "query",
                "WISP signal": "wisp"
              };
              for (var i = 0; i < ts.length; i++) {
                var cfg = map[ts[i]];
                if (!cfg) return false;
                var v = null;
                if (cfg === "wisp") {
                  if (!document.documentElement.hasAttribute("data-wisp-active")) return false;
                  var ld = window.WISP_SIGNAL_DATA;
                  if (!ld) return false;
                  var ogs = vs[i].split("|"),
                    om = false;
                  for (var j = 0; j < ogs.length; j++) {
                    var acs = ogs[j].split(","),
                      am = true;
                    for (var k = 0; k < acs.length; k++) {
                      var pts = acs[k].trim().split("."),
                        cur = ld;
                      for (var p = 0; p < pts.length; p++) {
                        if (cur && typeof cur === "object") cur = cur[pts[p]];
                        else {
                          cur = null;
                          break
                        }
                      }
                      if (!cur) {
                        am = false;
                        break
                      }
                    }
                    if (am) {
                      om = true;
                      break
                    }
                  }
                  if (!om) return false;
                  continue
                }
                if (cfg === "query") v = window.location.search.substring(1);
                else if (cfg === "session") {
                  try {
                    v = window.sessionStorage.getItem("uj")
                  } catch (e) {}
                } else if (cfg === "ref") v = r;
                else v = ps.get(cfg);
                if (v === null) return false;
                var ogs = vs[i].split("|"),
                  om = false;
                for (var j = 0; j < ogs.length; j++) {
                  var acs = ogs[j].split(","),
                    am = true;
                  for (var k = 0; k < acs.length; k++) {
                    if (v.indexOf(acs[k].trim()) === -1) {
                      am = false;
                      break
                    }
                  }
                  if (am) {
                    om = true;
                    break
                  }
                }
                if (!om) return false
              }
              return true
            }
            for (var i = 0; i < cs.length; i++) {
              if (!m && ck(cs[i])) {
                cs[i].setAttribute("active", "");
                m = true
              } else {
                cs[i].removeAttribute("active")
              }
            }
            if (m) {
              c.setAttribute("has-active-condition", "");
              f && f.removeAttribute("active")
            } else {
              c.removeAttribute("has-active-condition");
              f && f.setAttribute("active", "")
            }
          })();
        </script>
      </gws-dynamic-module-container>
      <main id="main">
        <div id="m1" data-module="TemplateSpacer" data-g-section-id="spacer">
          <div style="--gws-spacer-background-color:transparent;--gws-spacer-mobile-size:48px;--gws-spacer-desktop-size:60px;" class="Spacer_spacer Spacer_filled Spacer_desktop Spacer_tablet Spacer_mobile Spacer_all"></div>
        </div>
        <section id="m2" data-module="TemplateDynamicModuleContainer" data-g-section-id="dynamic-module-container"><gws-dynamic-module-container data-module="TemplateDynamicModuleContainer">
            <div data-condition-type="HTTP referrer" data-match-value="workspace.preview.g6.goog|workspace.google.com|localhost" slot="condition" class="TemplateDynamicModuleContainer_conditionalModule">
              <section id="m1" data-module="Template5050Hero" data-g-section-id="5050-hero">
                <div>
                  <div style="Grid_grid" class="Grid_grid Template5050Hero_wrapper">
                    <div style="--gws-column-tablet-start:1;--gws-column-tablet-end:12;--gws-column-laptop-start:2;--gws-column-laptop-end:6;" class="Grid_column Template5050Hero_content Template5050Hero_fixedRightPadding">
                      <picture><img src="https://lh3.googleusercontent.com/iUtpcjJMoUoGHlpGCgDUUYHJmhImEmzXpZVGyf79KJnrmN5gCRiPvo1qsUhK12Eqr5E9JkPvjREKhtY4N7bj8oW2jLsRn0ItaULQ=e365-pa-nu-rw-w2499" srcset="https://lh3.googleusercontent.com/iUtpcjJMoUoGHlpGCgDUUYHJmhImEmzXpZVGyf79KJnrmN5gCRiPvo1qsUhK12Eqr5E9JkPvjREKhtY4N7bj8oW2jLsRn0ItaULQ=e365-pa-nu-rw-w2499 1x, https://lh3.googleusercontent.com/iUtpcjJMoUoGHlpGCgDUUYHJmhImEmzXpZVGyf79KJnrmN5gCRiPvo1qsUhK12Eqr5E9JkPvjREKhtY4N7bj8oW2jLsRn0ItaULQ=e365-pa-nu-rw-w2499 2x" alt="Google Drive product logo" width="2499" height="403" loading="lazy" class="Template5050Hero_eyebrowImage Template5050Hero_productLockupEyebrow" /></picture>
                      <div class="Template5050Hero_heading">
                        <h1 class="Heading_heading heading Heading_size:h1">Store and share files online </h1>
                      </div>
                      <div class="Text_container Text_body Text_lg Template5050Hero_body">
                        <p>AI-powered, secure cloud storage for seamless file sharing and enhanced collaboration. Up to 5TB storage per user.</p>
                        <div class="ButtonGroup_buttonGroup ButtonGroup_buttonGroupHorizontal button-group horizontal"><span class="gws-button"><a href="/products/drive/for-work/" data-g-event="drive: hero #5050-hero" data-g-action="/products/drive/for-work/" data-g-label="/products/drive/for-work/" data-uj-def="hero_5050_hero" aria-label="Try Google Drive for work" class="button"><span class="button__content">Try Drive for work</span></a></span><span class="gws-button"><a href="https://drive.google.com/drive/?dmr=1&amp;ec=wgc-drive-[module]-goto" target="_blank" rel="noopener noreferrer" data-g-event="drive: hero #5050-hero" data-g-action="https://drive.google.com/drive/?dmr=1&amp;ec=wgc-drive-%5bmodule%5d-goto" data-g-label="sign in " data-uj-def="hero_5050_hero" aria-label="Sign in to Google Drive" class="button button--medium"><span class="button__content">Sign in</span></a></span></div>
                      </div>
                    </div>
                    <div style="--gws-column-tablet-start:1;--gws-column-tablet-end:12;--gws-column-laptop-start:7;--gws-column-laptop-end:11;" class="Grid_column Template5050Hero_featureImage">
