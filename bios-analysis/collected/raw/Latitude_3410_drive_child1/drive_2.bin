        <section id="download" data-module="TemplateTwoColumn" data-g-section-id="download">
          <div class="TemplateTwoColumn_template">
            <div style="Grid_grid" class="Grid_grid TemplateTwoColumn_grid">
              <div style="--gws-column-tablet-start:2;--gws-column-tablet-end:11;--gws-column-laptop-start:2;--gws-column-laptop-end:5;" class="Grid_column TemplateTwoColumn_content TemplateTwoColumn_sixtyForty">
                <div>
                  <div class="TemplateTwoColumn_headingRow">
                    <h2 class="Heading_heading heading Heading_size:h3 TemplateTwoColumn_heading">Sync your desktop with Drive</h2>
                  </div>
                  <div class="Text_container Text_body Text_lg TemplateTwoColumn_body">
                    <p>Get the most out of Drive right from your computer. Automatically keep all your Drive files up to date and protected. Available for Windows and macOS.</p><span class="gws-button breakpoints--mobile breakpoints--tablet breakpoints--desktop"><a href="https://support.google.com/drive/answer/10838124" data-g-event="drive: body #download" data-g-action="download drive for desktop " data-uj-def="body_download" aria-label="Open the Download Drive for desktop page" data-href-macos="https://dl.google.com/drive-file-stream/GoogleDrive.dmg" data-href-windows="https://dl.google.com/drive-file-stream/GoogleDriveSetup.exe" class="button button--plain-text-link"><span class="button__content">Download Drive for desktop </span></a></span>
                  </div>
                </div>
              </div>
              <div style="--gws-column-tablet-start:2;--gws-column-tablet-end:11;--gws-column-laptop-start:6;--gws-column-laptop-end:11;" class="Grid_column TemplateTwoColumn_featureImage TemplateTwoColumn_sixtyForty">
