CST_LauncherAcWarning="Please do not remove the AC power!"
; (Secure)
CST_SecurityAcWarning="Please do not remove the AC power!"
; (WIN)
CST_AcNotConnectError="Insyde H2OFFT cannot run on battery power. Please plug in AC power and try again."
; (WIN)
CST_DcNotConnectError="Please insert system battery."
; (WIN)
CST_DcNotEnoughError="Battery is too low (%d < %d). Please charge your battery to %d%%."

; [Platform_Check]
; (WIN, EFI)
CST_NotTargetPlatform="This BIOS is not for your Notebook PC."

; [Bios_Version_Check]
; (WIN, EFI)
CST_SameVersion="The version of ROM file is the same as that of BIOS."
; (WIN, EFI)
CST_OlderVersion="The version of ROM file is not newer than that of BIOS."
; (WIN, EFI)
CST_CheckByBios="This BIOS file is not allow to flash. The flash process will be terminated."

; [FlashComplete]
; (WIN, EFI, Secure)
CST_PauseWarning="Press any key to continue..."

; [UpdateEC]
; (WIN, EFI)
CST_EcDockWarning="Get EC part information fail."

; [Others]
; (WIN)
CST_NotAllowFlashOnOCModeMessage="You are about to flash your BIOS, make sure Over Clocking is turn off. Press "OK" button to stop the flash process if it is enabled."

; [PasswordCheck]
; (WIN)
CST_MsgCaption="BIOS Password Confirmation"
; (WIN, EFI)
CST_MsgPreface="Please enter BIOS Password"
; (WIN)
CST_MsgSuccess="BIOS Password is correct."
; (WIN, EFI)
CST_MsgFailure="BIOS Password is invalid. Please check and retry."
; (WIN, EFI)
CST_MsgPasswordNotSet="BIOS Password is required. Please go to BIOS Setup Menu and setup the Password."

[SecurityFlashFactoryUpdate]
UpdateNvStorage=0
;                  default : 0.
;                        0 : Don't update NV storage area on secure boot support platform.
;                        1 : Force update NV storage area on secure boot support platform.

