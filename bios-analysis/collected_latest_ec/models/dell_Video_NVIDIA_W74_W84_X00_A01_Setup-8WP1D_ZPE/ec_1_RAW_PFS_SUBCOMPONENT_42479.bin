	<strings>
		<localized locale="0x0409">
			<string name="title" value="Graphics Driver"/>
			<string name="failedInfPlatformCheck" value="This NVIDIA graphics driver is not compatible with this version of Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="This NVIDIA graphics driver requires ${RequiredOSName}. You are running ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="This graphics driver could not find compatible graphics hardware."/>
			<string name="failedHardwareCompatibleCheck" value="This NVIDIA graphics driver not find compatible graphics hardware."/>
			<string name="3DVisionControllerUninstallWarning" value="The NVIDIA 3D Vision Controller Driver currently installed is not compatible with this graphics driver and will be uninstalled. To use NVIDIA 3D Vision, you must also install the latest 3D Vision Controller Driver."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0401">
			<string name="title" value="برنامج تشغيل الرسومات"/>
			<string name="failedInfPlatformCheck" value="برنامج تشغيل رسومات NVIDIA هذا غير متوافق مع هذا الإصدار من نظام التشغيل Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="برنامج تشغيل رسومات NVIDIA هذا يتطلب ${RequiredOSName}. أنت الآن تشغل ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="تعذر على برنامج تشغيل رسومات NVIDIA هذا العثور على برنامج رسومات متوافق."/>
			<string name="failedHardwareCompatibleCheck" value="تعذر على برنامج تشغيل رسومات NVIDIA هذا العثور على برنامج رسومات متوافق."/>
			<string name="3DVisionControllerUninstallWarning" value="برنامج تشغيل مراقب NVIDIA 3D Vision المثبت حالياً غير متوافق مع برنامج تشغيل الرسومات هذا وسيتم إلغاء التثبيت. لاستخدام NVIDIA 3D Vision، يجب عليك أيضاً تثبيت أحدث برنامج تشغيل مراقب ‎3D Vision."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0405">
			<string name="title" value="Ovladače grafiky"/>
			<string name="failedInfPlatformCheck" value="Tento ovladač grafiky NVIDIA není kompatibilní s touto verzí Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="Tento ovladač grafiky vyžaduje ${RequiredOSName}. Máte spuštěn ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Tento ovladač grafiky nemohl najít kompatibilní hardware grafiky."/>
			<string name="failedHardwareCompatibleCheck" value="Tento ovladač grafiky NVIDIA nemohl najít kompatibilní hardware grafiky."/>
			<string name="3DVisionControllerUninstallWarning" value="Aktuálně nainstalovaný ovladač řídící jednotky NVIDIA 3D Vision není kompatibilní s tímto grafickým ovladačem a bude odinstalován. Chcete-li použít NVIDIA 3D Vision, musíte nainstalovat také poslední ovladač řídící jednotky NVIDIA 3D Vision."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0406">
			<string name="title" value="Grafikdriver"/>
			<string name="failedInfPlatformCheck" value="Denne NVIDIA-grafikdriver er ikke kompatibel med denne version af Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="Denne NVIDIA-grafikdriver kræver ${RequiredOSName}. Du kører ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Denne grafikdriver kunne ikke finde kompatibel grafikhardware."/>
			<string name="failedHardwareCompatibleCheck" value="Denne NVIDIA grafikdriver kunne ikke finde kompatibel grafikhardware."/>
			<string name="3DVisionControllerUninstallWarning" value="Den driver, som er installeret i øjeblikket til NVIDIA 3D Vision Controller, er ikke kompatibel med denne grafikdriver og vil blive afinstalleret. Hvis du vil benytte NVIDIA 3D Vision, skal du også installere den nyeste driver til 3D Vision Controller."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0407">
			<string name="title" value="Grafiktreiber"/>
			<string name="failedInfPlatformCheck" value="Dieser NVIDIA Grafiktreiber ist mit dieser Windows-Version nicht kompatibel."/>
			<string name="substitutedFailedInfPlatformCheck" value="Der NVIDIA Grafiktreiber benötigt ${RequiredOSName}. Sie führen ${RunningOSName} aus."/>
			<string name="failedHardwarePresentCheck" value="Der Grafiktreiber konnte keine kompatible Grafikhardware finden."/>
			<string name="failedHardwareCompatibleCheck" value="Der NVIDIA Grafiktreiber konnte keine kompatible Grafikhardware finden."/>
			<string name="3DVisionControllerUninstallWarning" value="Der momentan installierte NVIDIA 3D Vision Controller-Treiber ist mit diesem Grafiktreiber nicht kompatibel und wird deinstalliert. Um NVIDIA 3D Vision zu verwenden, muss auch der neueste 3D Vision Controller-Treiber installiert werden."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
