			<string name="failedInfPlatformCheck" value="Этот графический драйвер NVIDIA несовместим с данной версией Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="Для этого графического драйвера NVIDIA требуется ${RequiredOSName}. Работает ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Этот графический драйвер не обнаружил совместимого графического оборудования."/>
			<string name="failedHardwareCompatibleCheck" value="Этот графический драйвер NVIDIA не обнаружил совместимого графического оборудования."/>
			<string name="3DVisionControllerUninstallWarning" value="Установленный драйвер контроллера NVIDIA 3D Vision несовместим с этим графическим драйвером и поэтому будет удален. Для использования NVIDIA 3D Vision необходимо также установить последнюю версию драйвера контроллера 3D Vision."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x041b">
			<string name="title" value="Grafický ovládač"/>
			<string name="failedInfPlatformCheck" value="Grafický ovládač NVIDIA nie je kompatibilný s touto verziou systému Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="Tento grafický ovládač NVIDIA vyžaduje systém ${RequiredOSName}. Na vašom počítači je nainštalovaný systém ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Pre tento grafický ovládač sa nepodarilo nájsť kompatibilný grafický hardvér."/>
			<string name="failedHardwareCompatibleCheck" value="Pre tento grafický ovládač NVIDIA sa nepodarilo nájsť kompatibilný grafický hardvér."/>
			<string name="3DVisionControllerUninstallWarning" value="Aktuálne nainštalovaný ovládač NVIDIA 3D Vision Controller Driver nie je kompatibilný s týmto grafickým ovládačom a bude odinštalovaný. Ak chcete používať softvér NVIDIA 3D Vision, musíte nainštalovať aj najnovší ovládač 3D Vision Controller Driver."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0424">
			<string name="title" value="Grafični gonilnik"/>
			<string name="failedInfPlatformCheck" value="Ta grafični gonilnik NVIDIA ni združljiv s to različico programa Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="Ta grafični gonilnik NVIDIA zahteva ${RequiredOSName}. Vi uporabljate ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Ta grafični gonilnik ni mogel najti združljive grafične strojne opreme."/>
			<string name="failedHardwareCompatibleCheck" value="Ta grafični gonilnik ni mogel najti združljive grafične strojne opreme."/>
			<string name="3DVisionControllerUninstallWarning" value="Gonilnik za krmilnik NVIDIA 3D Vision, ki je trenutno nameščen, ni združljiv s tem grafičnim gonilnikom in bo odstranjen. Če želite uporabiti NVIDIA 3D Vision, morate namestiti tudi najnovejši gonilnik za krmilnik 3D Vision."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x041d">
			<string name="title" value="Grafikdrivrutin"/>
			<string name="failedInfPlatformCheck" value="Denna NVIDIA-grafikdrivrutin inte är kompatibel med denna version av Windows."/>
			<string name="substitutedFailedInfPlatformCheck" value="Denna NVIDIA-grafikdrivrutin kräver ${RequiredOSName}. Du kör ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Denna grafikdrivrutin kunde inte hitta kompatibel grafikmaskinvara."/>
			<string name="failedHardwareCompatibleCheck" value="Denna NVIDIA  grafikdrivrutin kunde inte hitta kompatibel grafikmaskinvara."/>
			<string name="3DVisionControllerUninstallWarning" value="Den installerade NVIDIA 3D Vision Controller-drivrutinen är inte kompatibel med denna grafikdrivrutin och kommer därför att avinstalleras. Om du vill använda NVIDIA 3D Vision måste du också installera den senaste 3D Vision Controller-drivrutinen."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x041e">
			<string name="title" value="โปรแกรมควบคุมกราฟิก"/>
			<string name="failedInfPlatformCheck" value="โปรแกรมควบคุมการ์ดกราฟิกของ NVIDIA ไม่เข้ากันกับ Windows รุ่นนี้"/>
			<string name="substitutedFailedInfPlatformCheck" value="โปรแกรมควบคุมกราฟิกของ NVIDIA กำหนดให้ต้องมี ${RequiredOSName} คุณกำลังใช้ ${RunningOSName}"/>
			<string name="failedHardwarePresentCheck" value="โปรแกรมควบคุมกราฟิกนี้หาไม่พบฮาร์ดแวร์กราฟิกที่เข้ากันได้"/>
			<string name="failedHardwareCompatibleCheck" value="โปรแกรมควบคุมกราฟิกของ NVIDIA นี้ไม่พบฮาร์ดแวร์กราฟิกที่เข้ากันได้"/>
			<string name="3DVisionControllerUninstallWarning" value="โปรแกรมควบคุมของตัวควบคุม NVIDIA 3D Vision ที่มีติดตั้งอยู่ในปัจจุบันไม่สามารถเข้ากันได้กับโปรแกรมควบคุมกราฟิกรุ่นนี้ และจะถูกถอนการติดตั้ง ในการใช้ NVIDIA 3D Vision คุณต้องติดตั้งโปรแกรมควบคุมรุ่นล่าสุดของตัวควบคุม 3D Vision"/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x041f">
			<string name="title" value="Grafik Sürücüsü"/>
			<string name="failedInfPlatformCheck" value="Bu NVIDIA grafik sürücüsü, Windows'un bu sürümüyle uyumlu değildir."/>
			<string name="substitutedFailedInfPlatformCheck" value="Bu NVIDIA grafik sürücüsü ${RequiredOSName} gerektirir. Sizin işletim sisteminizse ${RunningOSName}."/>
			<string name="failedHardwarePresentCheck" value="Bu grafik sürücüsü, uyumlu grafik donanımı bulamadı."/>
			<string name="failedHardwareCompatibleCheck" value="Bu NVIDIA grafik sürücüsü, uyumlu grafik donanımı bulamadı."/>
			<string name="3DVisionControllerUninstallWarning" value="NVIDIA 3D Vision Denetleyici Sürücüsü şu anda kurulu durumda ancak bu grafik sürücüsüyle uyumlu değil ve kaldırılacak. NVIDIA 3D Vision'ı kullanmak için, en son 3D Vision Denetleyici Sürücüsü sürümünü de kurmalısınız."/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0804">
			<string name="title" value="图形驱动程序"/>
			<string name="failedInfPlatformCheck" value="此 NVIDIA 驱动程序与此 Windows 版本不兼容。"/>
			<string name="substitutedFailedInfPlatformCheck" value="此 NVIDIA 图形驱动程序要求 ${RequiredOSName}。您正在运行 ${RunningOSName}。"/>
			<string name="failedHardwarePresentCheck" value="此图形驱动程序无法找到兼容的图形硬件。"/>
			<string name="failedHardwareCompatibleCheck" value="此 NVIDIA 图形驱动程序无法找到兼容的图形硬件。"/>
			<string name="3DVisionControllerUninstallWarning" value="当前安装的 NVIDIA 3D Vision 控制器驱动程序与此图形驱动程序不兼容，且将被卸载。要使用 NVIDIA 3D Vision，您还必须安装最新的 3D Vision 控制器驱动程序。"/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
		<localized locale="0x0404">
			<string name="title" value="圖形驅動程式"/>
			<string name="failedInfPlatformCheck" value="此 NVIDIA 圖形驅動程式與這個 Windows 版本不相容。"/>
			<string name="substitutedFailedInfPlatformCheck" value="此 NVIDIA 圖形驅動程式需要 ${RequiredOSName}。您正在執行 ${RunningOSName}。"/>
			<string name="failedHardwarePresentCheck" value="此圖形驅動程式找不到相容的圖形硬體。"/>
			<string name="failedHardwareCompatibleCheck" value="此 NVIDIA 圖形驅動程式找不到相容的圖形硬體。"/>
			<string name="3DVisionControllerUninstallWarning" value="目前所安裝的「3D Vision 控制器驅動程式」與這個圖形驅動程式不相容，因此將被解除安裝。若要使用 NVIDIA 3D Vision，您也必須安裝最新的「3D Vision 控制器驅動程式」。"/>
			<string name="arpDisplayName" value="NVIDIA ${{title}} ${{version}}"/>
		</localized>
	</strings>
	<description/>
	<interfaces>
		<interface name="stereoInterface" version="${{stereoInterfaceVersion}}"/>
	</interfaces>
	<constraints>
		<custom name="InfPlatformCheck" level="critical" text="${{failedInfPlatformCheck}}"/>
		<device name="HardwarePresentCheck" level="critical" text="${{failedHardwarePresentCheck}}"/>
		<custom name="3DVisionControllerInstalledCheck" text="${{3DVisionControllerUninstallWarning}}" level="warn"/>
	</constraints>
	<dependencies>
		<package type="uninstalls" package="Display.3DVision"/>
	</dependencies>
	<extensions>
		<extension file="DisplayDriverExt.DLL"/>
	</extensions>
	<properties>
		<bool name="FixedInstallLocation" value="true"/>
		<string name="InstallLocation" value=""/>
		<string name="ArpDisplayName" value="${{arpDisplayName}}"/>
		<string name="DriverServiceName" value="${{driverServiceName}}"/>
	</properties>
	<manifest>
		<file name="dbInstaller.exe"/>
		<file name="DisplayDriver.nvi"/>
		<file name="DisplayDriverExt.dll"/>
		<file name="license.txt"/>
		<file name="mcu.ex_"/>
		<file name="nvapi.dl_"/>
		<file name="nvapi64.dl_"/>
		<file name="nvcompiler.dl_"/>
		<file name="nvcompiler32.dl_"/>
		<file name="NvCplSetupInt.exe"/>
		<file name="nvcuda.dl_"/>
		<file name="nvcuda32.dl_"/>
		<file name="nvcuvenc.dl_"/>
		<file name="nvcuvenc64.dl_"/>
		<file name="nvcuvid.dl_"/>
		<file name="nvcuvid32.dl_"/>
		<file name="nvd3d9wrap.dl_"/>
		<file name="nvd3d9wrapx.dl_"/>
		<file name="nvd3dum.dl_"/>
		<file name="nvd3dumx.dl_"/>
		<file name="nvdebugdump.ex_"/>
		<file name="nvdet.dl_"/>
		<file name="nvdetx.dl_"/>
		<file name="nvdispco64.dll"/>
		<file name="nvdispgenco64.dll"/>
		<file name="nvdm.inf"/>
		<file name="nvdrsdb.bi_"/>
		<file name="nvdxgiwrap.dl_"/>
		<file name="nvdxgiwrapx.dl_"/>
		<file name="nvencodeapi.dl_"/>
		<file name="nvencodeapi64.dl_"/>
		<file name="nvidia-smi.1.pd_"/>
		<file name="nvidia-smi.ex_"/>
		<file name="nvinfo.pb"/>
		<file name="nvinit.dl_"/>
		<file name="nvinitx.dl_"/>
		<file name="nvkflt.sy_"/>
		<file name="nvlddmkm.sy_"/>
		<file name="nvml.dl_"/>
		<file name="nvoglv32.dl_"/>
		<file name="nvoglv64.dl_"/>
		<file name="nvopencl.dl_"/>
		<file name="nvopencl32.dl_"/>
		<file name="nvpciflt.sy_"/>
		<file name="nvumdshim.dl_"/>
		<file name="nvumdshimx.dl_"/>
		<file name="nvwgf2um.dl_"/>
		<file name="nvwgf2umx.dl_"/>
		<file name="opencl.dl_"/>
		<file name="opencl64.dl_"/>
		<file name="nvdm.cat"/></manifest>
	<phases>
		<standard phase="removeImplicitDirectories" when="uninstall">
			<deleteDirectory target="${{NvidiaProgramFiles}}\coprocmanager"/>
			<deleteDirectory target="${{NvidiaProgramFilesX86}}\coprocmanager"/>
		</standard>
		<device phase="installAllDrivers" fixedProgress="10" deviceProgress="150" autoTick="200">
			<inf name="*.inf"/>
			<hwid name="PCI\VEN_10DE¤"/>
		</device>
		<confirm phase="Confirm-install" when="install">
			<fileExists target="${{SystemDirectory}}\nvinfo.pb"/>
		</confirm>
		<confirm platform="x86" phase="Confirm-install" when="install">
			<fileExists target="${{SystemDirectory}}\nvapi.dll"/>
		</confirm>
		<confirm platform="amd64" phase="Confirm-install" when="install">
			<fileExists target="${{SystemDirectory}}\nvapi64.dll"/>
		</confirm>
		<standard phase="copyLogo" condition="ICafeLogoSupported" when="install" onError="ignore">
			<copyFile target="${{NvidiaProgramFiles}}\Drs\logo.png" source="logo.png"/>
		</standard>
		<custom phase="decideOpenCLCopy" action="decideOpenCLCopy" when="install">
			<properties>
				<string name="OpenCLLocation" value="${{NvidiaProgramFiles}}\OpenCL"/>
				<string name="OpenCLRegistryKey" value="HKLM\Software\Khronos\OpenCL\Vendors"/>
				<string name="OpenCLRegistryValueName" value="nvcuda.dll"/>
			</properties>
		</custom>
		<standard phase="copyOpenCL32" platform="x86" condition="CopyOpenCL32" when="install">
			<copyFile target="${{SystemDirectory}}\OpenCL.dll" source="${{NvidiaProgramFiles}}\OpenCL\OpenCL.dll"/>
		</standard>
		<standard phase="copyOpenCL64" condition="CopyOpenCL64" when="install">
			<copyFile target="${{SystemDirectory}}\OpenCL.dll" source="${{NvidiaProgramFiles}}\OpenCL\OpenCL64.dll"/>
		</standard>
		<if filter="minWin8">
			<custom phase="SetRebootForWin8KFilter" action="SetRebootForWin8KFilter" when="install"/>
		</if>
		<custom phase="changeDisplayResolution" action="SetResolution" when="install"/>
		<custom phase="removeOldARPEntry" action="RemoveOldARPEntry" onError="ignore" when="install"/>
		<standard phase="copyStereoUtility" platform="x86" condition="IsOSXP" onError="ignore">
			<createDirectory target="${{NvidiaProgramFilesX86}}\3D Vision"/>
			<copyFile target="${{NvidiaProgramFilesX86}}\3D Vision\NVStereoUtilityOGL.exe" source="NVStereoUtilityOGL.exe"/>
		</standard>
		<custom phase="updateCPLInstallPhaseApp" action="updateCPLInstallPhaseApp" when="install">
			<properties>
				<string name="CPLSearchPath" value="${{SubPackageDirectory}}"/>
			</properties>
		</custom>
		<custom phase="removeCPLInstallData" action="removeCPLInstallData"/>
		<exe phase="cplInstall" when="install" name="*setup*.exe" progress="500" autoTick="200">
			<arg value="-n"/>
			<arg value="-s"/>
			<arg value="Display.ControlPanel"/>
			<success value="0"/>
			<success value="1" rebootNeeded="true"/>
		</exe>
		<custom phase="checkRemoveOptimusFilters" action="checkRemoveOptimusFilters" when="install" onError="ignore"/>
		<standard phase="deleteComponents" when="uninstall" onError="ignore">
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvModes.dat"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvModes.001"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvdrsdb0.bin"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvdrsdb1.bin"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvdrssel.bin"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvdrswr.ilk"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\DRS\nvdrswr.lk"/>
			<deleteDirectory target="${{CommonAppData}}\NVIDIA Corporation\DRS"/>
			<deleteDirectory target="${{CommonAppData}}\NVIDIA Corporation"/>
			<deleteFile target="${{CommonAppData}}\nvModes.dat"/>
			<deleteFile target="${{CommonAppData}}\nvModes.001"/>
			<deleteFile target="${{SystemDirectory}}\nvdrsdb0.bin"/>
			<deleteFile target="${{SystemDirectory}}\nvdrsdb1.bin"/>
			<deleteFile target="${{SystemDirectory}}\nvdrssel.bin"/>
			<deleteFile target="${{SystemDirectory}}\nvdrswr.ilk"/>
			<deleteFile target="${{SystemDirectory}}\nvdrswr.lk"/>
		</standard>
		<custom phase="deleteMisc" action="DeleteMiscellaneousData" when="uninstall" onError="ignore"/>
		<standard phase="deleteRegistryKeys" onError="ignore" when="uninstall">
			<if filter="minWin7">
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.XResolution"/>
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.YResolution"/>
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.BitsPerPel"/>
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.VRefresh"/>
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.Flags"/>
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.XPanning"/>
				<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="DefaultSettings.YPanning"/>
				<deleteRegistryKey keyName="${{NvidiaSoftwareKey}}\Global\NVTweak"/>
			</if>
			<deleteRegistryKeyTree keyName="${{NvidiaSoftwareKey}}\Global\DRSPath"/>
			<deleteRegistryKey keyName="${{NvidiaSoftwareKey}}\Global"/>
			<deleteRegistryKey keyName="${{NvidiaSoftwareKey}}"/>
			<deleteRegistryKey keyName="${{NvidiaPerUserClassesKey}}"/>
		</standard>
		<standard phase="removeOpenCLFolder" when="uninstall" onError="ignore">
			<deleteDirectory target="${{NvidiaProgramFiles}}\OpenCL"/>
		</standard>
		<standard phase="removeOpenCL32" platform="x86" condition="RemoveOpenCL32" when="uninstall" onError="ignore">
			<deleteFile target="${{SystemDirectory}}\OpenCL.dll"/>
		</standard>
		<standard phase="removeOpenCL64" condition="RemoveOpenCL64" when="uninstall" onError="ignore">
			<deleteFile target="${{SystemDirectory}}\OpenCL.dll"/>
		</standard>
		<custom phase="decideOpenCLRemoval" action="decideOpenCLRemoval" when="uninstall" onError="ignore">
			<properties>
				<string name="OpenCLRegistryKey" value="HKLM\Software\Khronos\OpenCL\Vendors"/>
				<string name="OpenCLRegistryValueName" value="nvcuda.dll"/>
			</properties>
		</custom>
	</phases>
</nvi>
