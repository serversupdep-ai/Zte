API_BIND=0.0.0.0
API_PORT=8000
WEB_BIND=0.0.0.0
WEB_PORT=5173
# Same-origin: the browser talks to the Vite server, which proxies /api to the backend.
VITE_API_BASE_URL=

APP_NAME=FC1B Unlock Agent
APP_DESCRIPTION=Specialist agent for decrypting and clearing Dell BIOS master passwords: the FC1B / CF1B / 8FC8 firmware-lock family via BIOS dump patching, plus legacy suffix (595B, D35B, 2A7B, A95B, 1D3B, 1F5A, 1F66, 6FF1, BF97, E7A8) master password generation from a service tag. Active case: Dell Precision 3640 Tower CVZKKD3-CF1B.
KNOWLEDGE_DIR=knowledge
MAX_QUESTION_CHARS=8000
MAX_CONTEXT_CHARS=12000
MAX_DOCUMENT_BYTES=1000000
MAX_KNOWLEDGE_DOCUMENTS=256
MAX_KNOWLEDGE_BYTES=16000000
MAX_HISTORY_CHARS=24000
MAX_ANSWER_CHARS=50000
MAX_PROVIDER_RESPONSE_BYTES=2000000
MAX_REQUEST_BODY_BYTES=262144
PROVIDER_TIMEOUT_SECONDS=60

# Local deterministic mode: no external LLM provider, answers are grounded in the knowledge corpus.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

CORS_ORIGINS=http://localhost:5173
